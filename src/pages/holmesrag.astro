---
export const prerender = true;

import { getEntry, render } from "astro:content";
import Markdown from "@components/common/markdown.astro";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";
import HolmesRAGChat from "@components/HolmesRAGChat.astro";

const pageTitle = "HolmesRAG";
const pageDescription = "HolmesRAG - Sherlock Holmes Chatbot Live Demo";

const holmesragPost = await getEntry("spec", "holmesrag");

if (!holmesragPost) {
    throw new Error("HolmesRAG page content not found");
}

const { Content } = await render(holmesragPost);
const apiUrl = import.meta.env.PUBLIC_HOLMESRAG_API ?? '';
---

<GridLayout title={pageTitle} description={pageDescription}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <BackwardButton currentPath={Astro.url.pathname} />
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32 mt-6">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <h2 class="text-xl font-bold mb-4">HolmesRAG Live Demo</h2>
            <HolmesRAGChat apiUrl={apiUrl} />
        </div>
    </div>
</GridLayout>
