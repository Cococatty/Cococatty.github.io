---
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import ImageWrapper from "@components/common/imageWrapper.astro";
import PostMetadata from "@components/post/postMeta.astro";
import type { Moment } from "@utils/diary";

interface Props {
    moment: Moment;
    href?: string;
    class?: string;
    style?: string;
}

const { moment, href = "/diary/", class: className = "", style = "" } = Astro.props;
const published = new Date(moment.date);
const excerpt = moment.description || moment.content;
const hasImage = moment.images && moment.images.length > 0;
const coverImage = hasImage ? moment.images![0] : "";
const coverWidth = "28%";
---

<div class:list={["card-base flex flex-col-reverse md:flex-col w-full rounded-(--radius-large) overflow-hidden relative", className]} style={style}>
    <div class:list={["pl-6 md:pl-9 pr-6 md:pr-2 pt-6 md:pt-7 pb-6 relative", {"w-full md:w-[calc(100%-var(--coverWidth)-12px)]": hasImage, "w-full": !hasImage}]}> 
        <a href={href}
           class="transition group w-full block font-bold mb-3 text-3xl text-90
            hover:text-(--primary) dark:hover:text-(--primary)
            active:text-(--title-active) dark:active:text-(--title-active)
            before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
            before:absolute before:top-[35px] before:left-[18px] before:hidden md:before:block
        ">
            {moment.title || i18n(I18nKey.diary)}
            <span class="text-(--primary) text-[2rem] md:hidden absolute right-0 top-0">›</span>
        </a>
        <div class="transition text-75 mb-3.5 pr-4">
            {excerpt}
        </div>
        <div class="mt-5">
            <PostMetadata
                published={published}
                tags={moment.tags}
                hideUpdateDate={true}
                isHome={true}
                className="text-sm"
            />
        </div>
    </div>

    {hasImage && (
        <a href={href}
           aria-label={moment.title || i18n(I18nKey.diary)}
           class:list={["group",
                "max-h-[20vh] md:max-h-none mx-4 mt-4 -mb-2 md:mb-0 md:mx-0 md:mt-0",
                "md:w-(--coverWidth) relative md:absolute md:top-3 md:bottom-3 md:right-3 rounded-xl overflow-hidden active:scale-95"
            ]}
        >
            <div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/30 group-active:bg-black/50 transition"></div>
            <div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center ">
                <span class="transition opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 text-white text-5xl">›</span>
            </div>
            <ImageWrapper src={coverImage} basePath={moment.basePath} alt={moment.title || i18n(I18nKey.diary)} class="w-full h-full" />
        </a>
    )}

    {!hasImage && (
        <a href={href} aria-label={moment.title || i18n(I18nKey.diary)} class="hidden! md:flex! btn-regular w-13
            absolute right-3 top-3 bottom-3 rounded-xl bg-(--enter-btn-bg)
            hover:bg-(--enter-btn-bg-hover) active:bg-(--enter-btn-bg-active) active:scale-95
        ">
            <span class="transition text-(--primary) text-4xl mx-auto">›</span>
        </a>
    )}
</div>

<style define:vars={{ coverWidth }}>
</style>
